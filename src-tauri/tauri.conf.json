{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-ai-assistant",
  "version": "1.6.0",
  "identifier": "com.xilore.myaiassistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI 助手 · 用量与费用",
        "width": 1180,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 640,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0a0e16"
      },
      {
        "label": "tray",
        "url": "tray.html",
        "title": "账户面板",
        "width": 400,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4QTY4N0NGREE4NDY1MzMKUldRelpZVGF6NGVtYUN1OFZ5R09xODc0dXdWd1g0b2ZSUlVOa21OenB6b1dFYjlwTzc0WE9sV0oK",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
