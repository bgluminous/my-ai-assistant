{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-ai-assistant",
  "version": "1.0.0",
  "identifier": "com.xilore.myaiassistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AI 助手 · 用量与费用",
        "width": 1180,
        "height": 860,
        "minWidth": 1180,
        "minHeight": 640,
        "resizable": true
      },
      {
        "label": "tray",
        "url": "tray.html",
        "title": "账户面板",
        "width": 350,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
