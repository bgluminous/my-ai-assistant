{
  "openapi": "3.1.0",
  "info": {
    "title": "MAA GPT usage sync",
    "version": "1.0.0",
    "description": "MAA v1 client/server contract, aligned with the 2026-10-12 account-based server delivery. See gpt-usage-sync-v1.md for hashing, transactions, cursors and deduplication."
  },
  "servers": [
    {
      "url": "https://sync.example.com",
      "description": "Replace with configured base URL; may contain a path prefix"
    }
  ],
  "security": [
    {
      "SyncKey": []
    }
  ],
  "paths": {
    "/api/v1/codex-usage/handshake": {
      "get": {
        "operationId": "handshake",
        "summary": "Validate key and protocol without uploading data",
        "responses": {
          "200": {
            "description": "Success; uncompressed JSON at most 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Handshake"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or reset account key; pause automatic sync",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Account disabled; enable through the administrator, then retry manually",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Space, epoch or cursor reset required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds 1 MiB or 500 records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Server retry hint. The v1 client retains its 5/10/20/30-minute backoff, capped at 30 minutes.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Only validates the account and protocol. Does not register a device or upload data. No deviceId query parameter."
      }
    },
    "/api/v1/codex-usage/push": {
      "post": {
        "operationId": "push",
        "summary": "Atomically accept this device's immutable records; idempotent on space/device/recordId",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Push"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; uncompressed JSON at most 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acknowledged"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or reset account key; pause automatic sync",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Account disabled; enable through the administrator, then retry manually",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Space, epoch or cursor reset required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds 1 MiB or 500 records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Server retry hint. The v1 client retains its 5/10/20/30-minute backoff, capped at 30 minutes.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Registers or renames the device even with an empty records array. Rejects unknown fields and duplicate recordId values within a batch."
      }
    },
    "/api/v1/codex-usage/changes": {
      "get": {
        "operationId": "changes",
        "summary": "Download ordered changes using a cursor with a fixed snapshot upper bound",
        "parameters": [
          {
            "name": "spaceId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-maxUtf8Bytes": 256
            }
          },
          {
            "name": "epoch",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "x-maxUtf8Bytes": 256
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096,
              "x-maxUtf8Bytes": 4096
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 500
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; uncompressed JSON at most 1 MiB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or reset account key; pause automatic sync",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Account disabled; enable through the administrator, then retry manually",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Space, epoch or cursor reset required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Payload exceeds 1 MiB or 500 records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Server retry hint. The v1 client retains its 5/10/20/30-minute backoff, capped at 30 minutes.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Includes records from the requesting device. Record sources and device changes share the limit (default 500); the complete uncompressed JSON including the cursor is at most 1 MiB. No deviceId query parameter."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SyncKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "One current shared key per account, generated by the server administrator. All devices of an account use the same key; this is not an OpenAI credential. Key rotation preserves the space, epoch and history."
      }
    },
    "schemas": {
      "Device": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-maxUtf8Bytes": 128
          }
        },
        "required": [
          "deviceId",
          "name"
        ]
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "session"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "x-maxUtf8Bytes": 512
          },
          "forkedFromId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "x-maxUtf8Bytes": 512
              },
              {
                "type": "null"
              }
            ]
          },
          "createdAt": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "description": "UTC Unix milliseconds within Chrono 0.4.45 range; decimal integer spelling only (no fraction, exponent or negative zero)",
                "maximum": 8210266876799999
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "sessionId",
          "forkedFromId",
          "createdAt"
        ]
      },
      "Usage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "usage"
          },
          "sessionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "x-maxUtf8Bytes": 512
          },
          "timestampMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "description": "UTC Unix milliseconds within Chrono 0.4.45 range; decimal integer spelling only (no fraction, exponent or negative zero)",
                "maximum": 8210266876799999
              },
              {
                "type": "null"
              }
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "x-maxUtf8Bytes": 512
          },
          "inputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "description": "Non-cached input tokens"
          },
          "cacheReadTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "outputTokens": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalUsage": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "minItems": 5,
                "maxItems": 5,
                "description": "input,cached,output,reasoning,total cumulative counters"
              },
              {
                "type": "null"
              }
            ]
          },
          "occurrence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Zero when totalUsage is present; otherwise occurrence ordinal for identical normalized events"
          }
        },
        "required": [
          "kind",
          "sessionId",
          "timestampMs",
          "model",
          "inputTokens",
          "cacheReadTokens",
          "outputTokens",
          "totalUsage",
          "occurrence"
        ]
      },
      "Record": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Session"
          },
          {
            "$ref": "#/components/schemas/Usage"
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "WireRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of fixed-field compact UTF-8 JSON array, see companion protocol"
          },
          "record": {
            "$ref": "#/components/schemas/Record"
          }
        },
        "required": [
          "recordId",
          "record"
        ]
      },
      "RemoteRecord": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deviceId": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "item": {
            "$ref": "#/components/schemas/WireRecord"
          }
        },
        "required": [
          "deviceId",
          "item"
        ]
      },
      "Handshake": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "spaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "epoch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          }
        },
        "required": [
          "protocolVersion",
          "spaceId",
          "epoch"
        ]
      },
      "Push": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "spaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "epoch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "device": {
            "$ref": "#/components/schemas/Device"
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WireRecord"
            },
            "maxItems": 500
          }
        },
        "required": [
          "protocolVersion",
          "spaceId",
          "epoch",
          "device",
          "records"
        ]
      },
      "Acknowledged": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "spaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "epoch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "acknowledgedIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "uniqueItems": true,
            "maxItems": 500
          }
        },
        "required": [
          "spaceId",
          "epoch",
          "acknowledgedIds"
        ]
      },
      "Page": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "spaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "epoch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "x-maxUtf8Bytes": 256
          },
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RemoteRecord"
            },
            "maxItems": 500
          },
          "devices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Device"
            },
            "maxItems": 500
          },
          "nextCursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "x-maxUtf8Bytes": 4096
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "spaceId",
          "epoch",
          "records",
          "devices",
          "nextCursor",
          "hasMore"
        ],
        "description": "records.length + devices.length must not exceed the requested limit (1..500, default 500). Includes source records and device-name history snapshots within a fixed upper bound. Cursors survive normal restarts."
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-maxUtf8Bytes": 64
          },
          "message": {
            "type": "string",
            "maxLength": 1024
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    }
  }
}
